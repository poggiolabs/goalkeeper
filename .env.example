DATABASE_URL=postgresql://goalkeeper:goalkeeper@127.0.0.1:5432/goalkeeper
API_HOST=0.0.0.0
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
MCP_HOST=127.0.0.1
MCP_PORT=3002
PUBLIC_MCP_URL=http://127.0.0.1:3002/mcp
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=http://127.0.0.1:3002
AUTH_PROVIDER=email
EMAIL_DELIVERY=log
# Invitation email is optional. Without a mailer the API still creates the
# invitation and returns a shareable link. To send, set:
# EMAIL_DELIVERY=smtp
# EMAIL_FROM='Goalkeeper <invites@example.com>'
# SMTP_URL='smtps://api_token:<percent-encoded-token>@smtp.mx.cloudflare.net'
# Trusted-ingress deployments instead use AUTH_PROVIDER=trusted_proxy plus:
# AUTH_PROXY_SECRET=<at-least-32-byte-shared-secret>
# AUTH_PROXY_ISSUER=deployment-ingress
# AUTH_PROXY_AUDIENCE=goalkeeper-production
# AUTH_PROXY_LOGIN_URL=https://example.com/_auth/login
# AUTH_PROXY_LOGOUT_URL=https://example.com/_auth/logout
VITE_API_URL=http://localhost:3001
VITE_DOCS_URL=http://localhost:3003/docs
VITE_MCP_URL=http://127.0.0.1:3002/mcp
